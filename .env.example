# ==================== 数据库配置 ====================
# MySQL 数据库配置
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/blog"

# ==================== Redis 配置 ====================
# Redis 连接配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# ==================== 应用配置 ====================
# Node 环境 (development/production)
NODE_ENV=development
PORT=3000

# JWT Secret (用于加密token)
JWT_SECRET=your-secret-key-here-change-in-production

# API Base URL (可选)
NEXT_PUBLIC_API_URL=

# ==================== 腾讯云 COS 配置 ====================
# 用于文件上传功能（Markdown 编辑器中的图片上传）
SecretId=your-cos-secret-id
SecretKey=your-cos-secret-key
Bucket=your-bucket-name
Region=ap-shanghai
CDN_URL=https://static.your-domain.com

# ==================== 腾讯云页面 CDN 刷新 ====================
CDN_SITE_URL=https://www.your-domain.com
CDN_PURGE_SECRET=replace-with-a-long-random-secret
# 容器内直接访问 Next.js 源站，用于缓存预热（可选）
CACHE_ORIGIN_URL=http://127.0.0.1:3000

# ==================== Docker 部署配置 ====================
# Docker 容器中连接宿主机服务时使用
# Mac/Windows: host.docker.internal
# Linux: 使用宿主机的实际 IP 地址
DOCKER_HUB_TOKEN=your-docker-hub-token
DOCKERHUB_USERNAME=your-dockerhub-username
DEPLOY_HOST=your-deploy-host
DEPLOY_USER=your-deploy-user
DEPLOY_PORT=22
DEPLOY_DIR=/path/to/deployment
DEPLOY_WEBHOOK_SECRET=your-deploy-webhook-secret
DEPLOY_WEBHOOK_URL=https://www.nnnnzs.cn/api/deploy/webhook

# ==================== 向量数据库 ====================
# Qdrant 配置（已迁移至数据库，以下配置作为后备）
# 请在系统配置管理页面添加以下配置：
#   - qdrant.url: Qdrant 服务地址（如 http://localhost:6333）
#   - qdrant.api_key: API 密钥（可选）
#   - qdrant.timeout: 超时时间（可选，默认 30000 毫秒）
#
# 以下环境变量仅作为后备配置，建议使用数据库配置
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_TIMEOUT=30000

# ==================== 微信小程序 ====================
WX_APP_ID=your-wechat-app-id
WX_APP_SECRET=your-wechat-app-secret

# ==================== GitHub OAuth ====================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# ==================== GitHub API ====================
# 用于首页 commit 活动数据获取和部署历史查询
# 不配置时仍可运行，但 GitHub API 匿名请求速率限制为 60 次/小时
GITHUB_TOKEN=ghp_your_github_token

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==================== 评论通知邮件 ====================
# 通知服务 API；未配置时使用 NEXT_PUBLIC_API_URL/email/send
EMAIL_NOTIFICATION_API_URL=https://api.your-domain.com/email/send
# 退订链接签名密钥；未配置时回退 JWT_SECRET
NOTIFICATION_UNSUBSCRIBE_SECRET=your-notification-unsubscribe-secret

# ==================== 腾讯云人脸识别（IAI）配置 ====================
# 腾讯云 IAI 区域
TENCENT_IAI_REGION=ap-shanghai
# 腾讯云人员库 GroupId（需在腾讯云控制台手动创建）
FACE_GROUP_ID=blog_users

# ==================== 说明 ====================
# 1. 数据库配置：
#    - 应用不使用 DB_* 变量；这些变量仅供外部运维/迁移脚本按需参考
#    - Prisma 仅使用 DATABASE_URL
#
# 2. Docker 部署：
#    - 在 Docker 容器中，将 DATABASE_URL 中的数据库主机和 REDIS_HOST 改为 host.docker.internal
#    - 或者使用 Docker Compose 管理服务
#
# 3. 已迁移至数据库的配置：
#    - AI 模型配置（chat, embedding, description, ai_text）→ 数据库 tb_config 表
#    - Qdrant 向量数据库配置 → 数据库 tb_config 表
#    - TTS 语音合成配置 → 数据库 tb_config 表
#    - 请在系统配置管理页面添加，或使用 scripts/db/migrate-ai-config-to-provider.ts 迁移
#    - 参考 scripts/README-AI-CONFIG.md 了解详细配置方法
#
# 4. 安全提示：
#    - 生产环境中务必修改所有默认密码和密钥
#    - 不要将包含真实密钥的 .env 文件提交到 Git
